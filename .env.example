# Copiar estos nombres como variables de entorno.
# Nunca escribir contraseñas reales en este archivo.

QCC_DB_HOST=servidor-mysql
QCC_DB_PORT=3306
QCC_DB_NAME=calidad
QCC_DB_USER=usuario_desarrollo
QCC_DB_PASSWORD=contraseña_no_guardar

# Secreto para firmar los JWT del login (minimo 32 caracteres, no reutilizar entre entornos)
QCC_JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
QCC_JWT_EXPIRATION_MINUTES=60